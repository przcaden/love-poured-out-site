---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../site.config';

const coffeeCount = (await getCollection('coffee')).filter((e) => e.data.available).length;

// Menu sections shown on the landing page. `href` set = live; null = coming soon.
const sections = [
  { name: 'Coffees', href: '/coffee', desc: 'Hot and iced espresso drinks, made with love.', count: coffeeCount },
  { name: 'Coffee Beans', href: null, desc: 'Flavored beans and house roasts, by the bag.', count: null },
  { name: 'Refreshers', href: null, desc: 'Lemonades and refreshers — crisp and bright.', count: null },
  { name: 'Syrups', href: null, desc: 'A little sweetness to add to any drink.', count: null },
];
---
<Base>
  <SiteHeader />

  <section class="hero">
    <div class="hero__mark">
      <img class="hero__logo" src="/logo.png" alt="" width="1254" height="1254" />
      <div class="hero__wordmark">
        <p class="hero__love">Love</p>
        <p class="hero__script">Poured Out</p>
      </div>
    </div>
    <p class="hero__verse">{site.verse}</p>
    <p class="hero__tag">{site.tagline}</p>
  </section>

  <div class="rule-heart" aria-hidden="true">♡</div>

  {/* Temporary under-construction splash — remove this whole <section> (and its <style>) at launch. */}
  <section class="construction" aria-label="Site under construction">
    <div class="construction__inner">
      <div class="construction__art construction__art--left">
        <svg viewBox="0 0 175 150" role="img" aria-label="Traffic cone and coffee beans">
          <defs>
            <clipPath id="coneClipL"><path d="M22 130 L39 56 C42 48 50 48 53 56 L70 130 Z" /></clipPath>
          </defs>
          <ellipse cx="72" cy="136" rx="54" ry="8" fill="rgba(30,45,67,0.18)" />
          <rect x="10" y="124" width="72" height="15" rx="7" fill="#8aa9cd" stroke="#4e6f97" stroke-width="2" />
          <g clip-path="url(#coneClipL)">
            <rect x="8" y="48" width="80" height="82" fill="#9cbce0" />
            <rect x="8" y="74" width="80" height="12" fill="#ffffff" />
            <rect x="8" y="98" width="80" height="12" fill="#ffffff" />
          </g>
          <path d="M22 130 L39 56 C42 48 50 48 53 56 L70 130 Z" fill="none" stroke="#4e6f97" stroke-width="2.5" stroke-linejoin="round" />
          <g stroke="#43301d">
            <g transform="translate(114 106) rotate(-22)">
              <ellipse cx="0" cy="0" rx="23" ry="15" fill="#6f4a2c" stroke-width="2" />
              <path d="M0 -13 C -6 -5 -6 5 0 13" fill="none" stroke-width="2.5" />
            </g>
            <g transform="translate(142 121) rotate(16)">
              <ellipse cx="0" cy="0" rx="21" ry="13.5" fill="#805636" stroke-width="2" />
              <path d="M0 -12 C -5 -4 -5 4 0 12" fill="none" stroke-width="2.5" />
            </g>
          </g>
        </svg>
      </div>

      <div class="construction__body">
        <h2 class="construction__heading">We're brewing something special</h2>
        <p class="construction__text">
          Love Poured Out is currently under construction as we prepare for our official
          launch. Stay tuned and follow us on social media while we prepare our handcrafted
          coffees, flavored beans, and refreshing lemonades.
        </p>
        <p class="construction__coming">Coming Fall 2026</p>
      </div>

      <div class="construction__art construction__art--right">
        <svg viewBox="0 0 150 140" role="img" aria-label="Steaming coffee cup">
          <g fill="none" stroke="#3c5a80" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M62 48 q -10 -13 0 -24 q 7 -10 1 -18" opacity="0.75" />
            <path d="M82 48 q -10 -13 0 -24 q 7 -10 1 -18" opacity="0.75" />
          </g>
          <ellipse cx="72" cy="130" rx="50" ry="7" fill="rgba(30,45,67,0.15)" />
          <ellipse cx="72" cy="120" rx="52" ry="11" fill="#eef4fc" stroke="#3c5a80" stroke-width="3" />
          <path d="M36 64 L40 92 Q44 112 72 112 Q100 112 104 92 L108 64 Z" fill="#f7fbff" stroke="#3c5a80" stroke-width="3" stroke-linejoin="round" />
          <ellipse cx="72" cy="64" rx="36" ry="9" fill="#dfeaf7" stroke="#3c5a80" stroke-width="3" />
          <path d="M106 72 q 22 2 20 24 q -2 13 -20 14" fill="none" stroke="#3c5a80" stroke-width="3" />
        </svg>
      </div>
    </div>
  </section>

  <main>
    <nav class="section-nav" aria-label="Menu sections">
      {sections.map((s) =>
        s.href ? (
          <a class="nav-card" href={s.href}>
            <span class="nav-card__name">{s.name}</span>
            <span class="nav-card__desc">{s.desc}</span>
            <span class="nav-card__go">{s.count} {s.count === 1 ? 'drink' : 'drinks'} · View →</span>
          </a>
        ) : (
          <div class="nav-card nav-card--soon" aria-disabled="true">
            <span class="nav-card__name">{s.name}</span>
            <span class="nav-card__desc">{s.desc}</span>
            <span class="nav-card__go">Coming soon</span>
          </div>
        )
      )}
    </nav>
  </main>

  <SiteFooter />
</Base>

<style>
  /* Temporary under-construction splash (marbled blue panel to match the mockup) */
  .construction {
    max-width: var(--maxw);
    margin: 2.2rem auto 0;
    padding: 0 1.5rem;
  }
  .construction__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 3vw, 2rem);
    padding: clamp(1.3rem, 3.5vw, 2rem) clamp(1.4rem, 4vw, 2.2rem);
    border-radius: 16px;
    color: #223349;
    background-color: #a7bfdb;
    background-image:
      radial-gradient(140% 120% at 16% 0%, rgba(214, 227, 244, 0.95), rgba(214, 227, 244, 0) 44%),
      radial-gradient(120% 130% at 100% 100%, rgba(132, 159, 197, 0.55), rgba(132, 159, 197, 0) 48%),
      radial-gradient(90% 90% at 62% 38%, rgba(255, 255, 255, 0.30), rgba(255, 255, 255, 0) 55%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    overflow: hidden;
  }
  .construction__art { flex: 0 0 auto; }
  .construction__art svg { display: block; width: 100%; height: auto; }
  .construction__art--left { width: clamp(104px, 20vw, 170px); }
  .construction__art--right { width: clamp(88px, 16vw, 134px); }
  .construction__body { flex: 1 1 auto; text-align: center; }
  .construction__heading {
    margin: 0 0 0.55rem;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: clamp(1.15rem, 3.2vw, 1.7rem);
    line-height: 1.15;
    color: #223349;
  }
  .construction__text {
    margin: 0 auto;
    max-width: 52ch;
    font-family: var(--body);
    color: #223349;
    font-size: clamp(0.98rem, 2.3vw, 1.1rem);
    line-height: 1.55;
  }
  .construction__coming {
    margin: 0.5rem 0 0;
    font-family: var(--script);
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1;
    color: #1d2d43;
  }

  @media (max-width: 680px) {
    /* keep the splash readable on phones — hide the flanking illustrations */
    .construction__art { display: none; }
  }
</style>
