---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeSpotlight from '../components/HomeSpotlight.astro';
import { site } from '../site.config';

const coffeeCount = (await getCollection('coffee')).filter((e) => e.data.available).length;
const refreshersCount = (await getCollection('refreshers')).filter((e) => e.data.available).length;
const beansCount = (await getCollection('beans')).filter((e) => e.data.available).length;

// Homepage slideshow — driven by the Home Spotlight Airtable table. Same
// filter/sort convention as the menu pages: hide unavailable rows, respect
// the Order fallback (the Airtable view order wins when credentials are set).
const spotlightSlides = (await getCollection('spotlight'))
  .map((entry) => entry.data)
  .filter((s) => s.available)
  .sort((a, b) => a.order - b.order);

// Menu sections shown on the landing page. `href` set = live; null = coming soon.
const sections = [
  { name: 'Coffees', href: '/coffee', desc: 'Hot and iced espresso drinks, made with love.', count: coffeeCount },
  { name: 'Coffee Beans', href: '/beans', desc: 'Flavored beans and house roasts, by the bag.', count: beansCount },
  { name: 'Refreshers', href: '/refreshers', desc: 'Lemonades and refreshers — crisp and bright.', count: refreshersCount },
  { name: 'Syrups', href: null, desc: 'A little sweetness to add to any drink.', count: null },
];
---
<Base>
  <SiteHeader />

  <section class="hero">
    <div class="hero__mark">
      <img class="hero__logo" src="/logo.png" alt="" width="1254" height="1254" />
      <div class="hero__wordmark">
        <p class="hero__love">Love</p>
        <p class="hero__script">Poured Out</p>
      </div>
    </div>
    <p class="hero__verse">{site.verse}</p>
    <p class="hero__tag">{site.tagline}</p>
  </section>

  <div class="rule-heart" aria-hidden="true">♡</div>

  {/* Temporary under-construction splash — remove this whole <section> (and its <style>) at launch. */}
  <section class="construction" aria-label="Site under construction">
    <div class="construction__inner">
      <span class="construction__stripes construction__stripes--top" aria-hidden="true"></span>

      <div class="construction__body">
        <h2 class="construction__heading">We're brewing something special</h2>
        <p class="construction__text">
          Love Poured Out is currently under construction as we prepare for our official
          launch. Stay tuned and follow us on social media while we prepare our handcrafted
          coffees, flavored beans, and refreshing lemonades! <br> ♡
        </p>
        <p class="construction__coming"><strong>Coming Fall 2026</strong></p>
      </div>

      <span class="construction__stripes construction__stripes--bottom" aria-hidden="true"></span>
    </div>
  </section>

  <HomeSpotlight slides={spotlightSlides} />

  <main>
    <nav class="section-nav" aria-label="Menu sections">
      {sections.map((s) =>
        s.href ? (
          <a class="nav-card" href={s.href}>
            <span class="nav-card__name">{s.name}</span>
            <span class="nav-card__desc">{s.desc}</span>
            <span class="nav-card__go">{s.count} {s.count === 1 ? 'drink' : 'drinks'} · View →</span>
          </a>
        ) : (
          <div class="nav-card nav-card--soon" aria-disabled="true">
            <span class="nav-card__name">{s.name}</span>
            <span class="nav-card__desc">{s.desc}</span>
            <span class="nav-card__go">Coming soon</span>
          </div>
        )
      )}
    </nav>
  </main>

  <SiteFooter />
</Base>

<style>
  /* Temporary under-construction splash — black & yellow caution-sign styling */
  .construction {
    max-width: var(--maxw);
    margin: 2.2rem auto 0;
    padding: 0 1.5rem;
  }
  .construction__inner {
    overflow: hidden;
    border: 4px solid #141414;
    border-radius: 12px;
    background: #f4c026;                 /* caution yellow field */
    box-shadow: 0 12px 44px rgba(0, 0, 0, 0.55);
  }
  /* diagonal hazard-tape bands framing the panel, top and bottom */
  .construction__stripes {
    display: block;
    height: 18px;
    background: repeating-linear-gradient(45deg, #141414 0 16px, #f4c026 16px 32px);
  }
  .construction__stripes--top { border-bottom: 3px solid #141414; }
  .construction__stripes--bottom {
    border-top: 3px solid #141414;
    background: repeating-linear-gradient(-45deg, #141414 0 16px, #f4c026 16px 32px);
  }
  .construction__body {
    text-align: center;
    padding: clamp(1.4rem, 4vw, 2.2rem) clamp(1.4rem, 4vw, 2.4rem);
    color: #141414;
  }
  .construction__heading {
    margin: 0 0 0.55rem;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: clamp(1.15rem, 3.2vw, 2.0rem);
    line-height: 1.15;
    color: #141414;
  }
  .construction__text {
    margin: 0 auto;
    max-width: 52ch;
    font-family: var(--body);
    color: #1c1c1c;
    font-size: clamp(0.98rem, 2.3vw, 1.1rem);
    line-height: 1.55;
  }
  .construction__coming {
    margin: 0.5rem 0 0;
    font-family: var(--script);
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1;
    color: #141414;
  }
</style>