---
// Renders the row of social icon buttons. Used by SiteHeader in two places
// (the desktop header and the mobile menu) — kept as one component so the icon
// set only lives in one place. Pass `class` to size/lay out the row + buttons
// differently per context (see the `.nav__socials` / `.mobile-menu__socials`
// rules in global.css).
import { socials } from '../site.config';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

// Minimal hand-drawn glyphs (no icon package dependency) — simplified,
// single-color marks in the site's line-art style, not exact brand artwork.
const ICONS: Record<(typeof socials)[number]['name'], string> = {
  Instagram: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.2" />
    <circle cx="12" cy="12" r="4.1" />
    <circle cx="17.1" cy="6.9" r="1" fill="currentColor" stroke="none" />
  </svg>`,
  Facebook: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M13.9 21v-7.6h2.6l.4-3h-3v-1.9c0-.9.2-1.5 1.5-1.5h1.6V4.2C16.7 4.1 15.8 4 14.8 4c-2.2 0-3.7 1.3-3.7 3.8v2.6H8.5v3h2.6V21h2.8Z" fill="currentColor" />
  </svg>`,
  TikTok: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M15.6 3h-2.9v12.2a2.7 2.7 0 1 1-2-2.6v-3a5.7 5.7 0 1 0 4.9 5.6V9.1a7.5 7.5 0 0 0 4.3 1.4V7.6c-2.3-.1-4-1.6-4.3-4.6Z" fill="currentColor" />
  </svg>`,
};
---
{socials.length > 0 && (
  <div class:list={['socials', className]}>
    {socials.map((s) => (
      <a
        class="social-btn"
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Follow us on ${s.name}`}
        data-close
      >
        <span class="social-btn__icon" set:html={ICONS[s.name]} />
      </a>
    ))}
  </div>
)}
