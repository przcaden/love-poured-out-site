---
interface Props {
  name: string;
  description?: string;
  price?: string;
  image?: string;
  seasonal?: boolean;
  index?: number;
}
const { name, description = '', price = '', image = '', seasonal = false, index = 0 } = Astro.props;

// Owners can type "$4.50", "4.5", or "Market" — show a bare number as currency,
// otherwise print exactly what they wrote.
function formatPrice(p: string): string {
  if (!p) return '';
  const n = Number(p);
  return Number.isFinite(n) && p.trim() !== '' ? `$${n.toFixed(2)}` : p;
}
---

<article class="card" style={`--i:${index}`}>
  {image && (
    <div class="card__media">
      <img src={image} alt={name} loading="lazy" width="600" height="450" />
      {seasonal && <span class="card__tag">♡ Seasonal</span>}
    </div>
  )}

  <div class="card__line">
    <h3 class="card__name"><span class="card__heart" aria-hidden="true">♡</span>{name}</h3>
    <span class="card__leader" aria-hidden="true"></span>
    {price && <span class="card__price">{formatPrice(price)}</span>}
  </div>

  {description && <p class="card__desc">{description}</p>}
</article>

<style>
  .card { display: flex; flex-direction: column; }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
    background: var(--panel);
    border: 1px solid var(--line);
  }
  .card__media img { width: 100%; height: 100%; object-fit: cover; }

  .card__tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #05070b;
    background: var(--blue);
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
  }

  .card__line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .card__name {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1.08rem;
    line-height: 1.15;
    color: var(--blue);
  }
  .card__heart { color: var(--blue-deep); font-size: 0.8em; }

  /* the signature: a dotted leader running from the drink name to its price */
  .card__leader {
    flex: 1 1 auto;
    align-self: center;
    height: 0;
    border-bottom: 1.5px dotted var(--line);
    transform: translateY(1px);
  }
  .card__price {
    font-family: var(--body);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: 0.02em;
    color: var(--blue-bright);
    font-variant-numeric: tabular-nums;
  }

  .card__desc {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card {
      opacity: 0;
      transform: translateY(10px);
      animation: card-rise 0.55s ease forwards;
      animation-delay: calc(var(--i) * 45ms);
    }
    .card__media { transition: transform 0.3s ease, border-color 0.3s ease; }
    @media (hover: hover) {
      .card:hover .card__media {
        transform: translateY(-3px);
        border-color: color-mix(in srgb, var(--blue) 55%, transparent);
      }
    }
  }

  @keyframes card-rise {
    to { opacity: 1; transform: none; }
  }
</style>
