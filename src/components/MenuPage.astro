---
// Shared shell for every drink-menu page (Coffees, Refreshers, and whatever
// comes next — Coffee Beans, Syrups…). A page file just picks its collection
// and title; this component owns the fetch → filter → sort → render pattern
// so that logic lives in exactly one place.
//
// To add a new menu page once its Airtable table + collection exist:
//   <MenuPage collection="yourCollectionKey" title="Your Title" />
// (add `dualImage={true}` only for a page that ships paired hot/iced images,
// like Coffees; add `flexibleAspect={true}` for a page whose photos are
// square or 4:3 product shots rather than the default portrait card box,
// like Beans; add `fixedAspect="2 / 3"` (or any CSS aspect-ratio value) for a
// page where every photo is one consistent shape by convention, like Syrups —
// don't combine flexibleAspect and fixedAspect on the same page).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import MenuGrid from './MenuGrid.astro';
import { site } from '../site.config';
import type { collections } from '../content.config';

interface Props {
  collection: keyof typeof collections;
  title: string;
  dualImage?: boolean;
  flexibleAspect?: boolean;
  fixedAspect?: number | string;
}
const { collection, title, dualImage = false, flexibleAspect = false, fixedAspect } = Astro.props;

const drinks = (await getCollection(collection))
  .map((entry) => entry.data)
  .filter((d) => d.available)
  .sort((a, b) => a.order - b.order);
---
<Base title={`${title} · ${site.name}`}>
  <SiteHeader />
  <main>
    <MenuGrid title={title} drinks={drinks} dualImage={dualImage} flexibleAspect={flexibleAspect} fixedAspect={fixedAspect} />
  </main>
  <SiteFooter />
</Base>
