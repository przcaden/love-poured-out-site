# Copy this file to `.env` for local development.
# In production (Cloudflare Pages / Netlify), set these in the host's dashboard.
#
# Leave these unset to build with placeholder sample data (src/data/*.json).

AIRTABLE_TOKEN=pat_xxxxxxxxxxxxxx
AIRTABLE_BASE=appXXXXXXXXXXXXXX
# The name of the drag-to-reorder view, used in every table (default: "Grid view")
AIRTABLE_VIEW=Grid view
